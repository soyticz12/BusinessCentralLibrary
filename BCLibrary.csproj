<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>BCLibrary</PackageId>                    <!-- Change this to your package ID -->
    <Version>1.0.0</Version>                            <!-- Update version as needed -->
    <Authors>Your Name or Company</Authors>
    <Company>Your Company</Company>
    <Description>A client library for Microsoft Dynamics 365 Business Central API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>  <!-- Change license if needed -->
    <PackageProjectUrl>https://github.com/yourrepo</PackageProjectUrl>  <!-- Optional -->
    <RepositoryUrl>https://github.com/yourrepo</RepositoryUrl>         <!-- Optional -->
    
    <!-- Generates the XML docs file used by IntelliSense and package consumers -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Include symbols for debugging if you want -->
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.73.0" />
  </ItemGroup>

</Project>
